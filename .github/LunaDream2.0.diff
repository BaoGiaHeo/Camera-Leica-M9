+    // ------------------------------------------------------------------------------------
+    // LunaDream 2.0 engine helpers.
+    //
+    // Everything below is used ONLY by LunaDream 2.0 (multi-frame merge and RawDream's
+    // single-frame pass). LunaDream 1.5 keeps using fuseLunaDreamFrameParallel and
+    // applyLunaDream15FinishingPass unchanged.
+    //
+    // The per-pixel maths is identical to the previous 2.0 implementation (temporal fusion
+    // gating, strength-2 edge-aware denoise, bounded luminance detail recovery). What changed
+    // is how the pixels travel through memory: buffers are allocated once per merge, rows are
+    // handed to workers dynamically, and Bitmap reads/writes for the next stripe overlap
+    // with the arithmetic of the current stripe. No pixel is resampled and no detail is
+    // synthesised.
+    // ------------------------------------------------------------------------------------
+    private const val LUNA20_MAX_WORKERS = 6
+    private const val LUNA20_STRIPE_ROWS = 128
+    private const val LUNA20_CHUNK_ROWS = 32
+
+    /** Reusable stripe buffers for temporal fusion: base rows and the aligned source rows. */
+    private class Luna20FusionStripe(pixels: Int) {
+        val base = IntArray(pixels)
+        val frame = IntArray(pixels)
+        var top = 0
+        var rows = 0
+    }
+
+    /** Stripe buffers for the finishing pass: source rows with a two-row halo plus output rows. */
+    private class Luna20FinishStripe(width: Int) {
+        val src = IntArray((LUNA20_STRIPE_ROWS + 4) * width)
+        val out = IntArray(LUNA20_STRIPE_ROWS * width)
+        var top = 0
+        var rows = 0
+    }
+
+    /** Per-worker scratch for one chunk: source luma, denoised rows and their luma. */
+    private class Luna20ChunkScratch(width: Int) {
+        val srcLuma = IntArray((LUNA20_CHUNK_ROWS + 4) * width)
+        val den = IntArray((LUNA20_CHUNK_ROWS + 2) * width)
+        val denLuma = IntArray((LUNA20_CHUNK_ROWS + 2) * width)
+    }
+
+    /**
+     * Starts [workerCount] runners that pull row chunks from a shared counter, so faster cores
+     * simply take more chunks. The caller overlaps its own I/O and then awaits the futures.
+     */
+    private fun launchRowJobs(
+        workers: ExecutorService,
+        workerCount: Int,
+        rows: Int,
+        chunkRows: Int,
+        body: (worker: Int, fromRow: Int, untilRow: Int) -> Unit
+    ): List<Future<Unit>> {
+        val nextRow = AtomicInteger(0)
+        return (0 until workerCount).map { worker ->
+            workers.submit(Callable<Unit> {
+                while (true) {
+                    val from = nextRow.getAndAdd(chunkRows)
+                    if (from >= rows) break
+                    body(worker, from, min(rows, from + chunkRows))
+                }
+                Unit
+            })
+        }
+    }
+
+    private fun hasMemoryForFramePrefetch(context: Context, width: Int, height: Int): Boolean {
+        val manager = context.getSystemService(Context.ACTIVITY_SERVICE) as? ActivityManager
+            ?: return false
+        val info = ActivityManager.MemoryInfo()
+        manager.getMemoryInfo(info)
+        val frameBytes = width.toLong() * height.toLong() * 2L
+        return !info.lowMemory && info.availMem > frameBytes * 3L + 768L * 1024L * 1024L
+    }
+
+    /**
+     * Temporal fusion for LunaDream 2.0. Same gating and blend equations as
+     * fuseLunaDreamFrameParallel (which 1.5 keeps using).
+     */
+    private fun fuseLunaDream20Frame(
+        base: Bitmap,
+        current: Bitmap,
+        width: Int,
+        height: Int,
+        shiftX: Int,
+        shiftY: Int,
+        frameIndex: Int,
+        totalMergedFrames: Int,
+        workers: ExecutorService,
+        workerCount: Int,
+        stripes: Array<Luna20FusionStripe>,
+        onProgress: ((Int) -> Unit)? = null
+    ) {
+        val stripeCount = (height + LUNA20_STRIPE_ROWS - 1) / LUNA20_STRIPE_ROWS
+        fun load(stripe: Int, target: Luna20FusionStripe) {
+            val top = stripe * LUNA20_STRIPE_ROWS
+            val rows = min(LUNA20_STRIPE_ROWS, height - top)
+            base.getPixels(target.base, 0, width, 0, top, width, rows)
+            for (row in 0 until rows) {
+                val sourceY = (top + row + shiftY).coerceIn(0, height - 1)
+                current.getPixels(target.frame, row * width, width, 0, sourceY, width, 1)
+            }
+            target.top = top
+            target.rows = rows
+        }
+
+        load(0, stripes[0])
+        for (stripe in 0 until stripeCount) {
+            val active = stripes[stripe and 1]
+            val pending = launchRowJobs(workers, workerCount, active.rows, LUNA20_CHUNK_ROWS) { _, fromRow, untilRow ->
+                fuseRowsLuna20(active.base, active.frame, width, fromRow, untilRow, shiftX, frameIndex)
+            }
+            // Read the next stripe while the workers blend this one.
+            if (stripe + 1 < stripeCount) load(stripe + 1, stripes[(stripe + 1) and 1])
+            pending.forEach { it.get() }
+            base.setPixels(active.base, 0, width, 0, active.top, width, active.rows)
+            val frameFraction = (frameIndex - 1 + (active.top + active.rows).toFloat() / height) /
+                totalMergedFrames.toFloat()
+            runCatching { onProgress?.invoke((5 + frameFraction * 90f).toInt()) }
+        }
+    }
+
+    private fun fuseRowsLuna20(
+        old: IntArray,
+        frame: IntArray,
+        width: Int,
+        fromRow: Int,
+        untilRow: Int,
+        shiftX: Int,
+        frameIndex: Int
+    ) {
+        val divisor = frameIndex + 1
+        for (row in fromRow until untilRow) {
+            val rowOffset = row * width
+            for (x in 0 until width) {
+                val index = rowOffset + x
+                val sourceX = (x + shiftX).coerceIn(0, width - 1)
+                val a = old[index]
+                val b = frame[rowOffset + sourceX]
+                val ar = (a ushr 16) and 0xFF
+                val ag = (a ushr 8) and 0xFF
+                val ab = a and 0xFF
+                val br = (b ushr 16) and 0xFF
+                val bg = (b ushr 8) and 0xFF
+                val bb = b and 0xFF
+                val oldLuma = luma(ar, ag, ab)
+                val newLuma = luma(br, bg, bb)
+                val lumaDelta = kotlin.math.abs(oldLuma - newLuma)
+                val colorDelta = max(
+                    kotlin.math.abs(ar - br),
+                    max(kotlin.math.abs(ag - bg), kotlin.math.abs(ab - bb))
+                )
+                val threshold = (16 + (oldLuma + newLuma) / 28).coerceIn(20, 38)
+                when {
+                    lumaDelta <= threshold && colorDelta <= threshold * 2 -> {
+                        old[index] = packRgb(
+                            (ar * frameIndex + br) / divisor,
+                            (ag * frameIndex + bg) / divisor,
+                            (ab * frameIndex + bb) / divisor
+                        )
+                    }
+                    lumaDelta <= threshold * 2 && colorDelta <= threshold * 3 -> {
+                        old[index] = packRgb(
+                            (ar * 7 + br) / 8,
+                            (ag * 7 + bg) / 8,
+                            (ab * 7 + bb) / 8
+                        )
+                    }
+                    // Large changes are treated as moving-object/ghost pixels.
+                    else -> Unit
+                }
+            }
+        }
+    }
+
+    /**
+     * LunaDream 2.0 finishing: strength-2 edge-aware denoise followed by the bounded 2.0
+     * luminance detail pass, computed in ONE streamed pass. Rows are processed in chunks that
+     * recompute their own one-row denoise halo, which is bit-identical to running the two passes
+     * one after the other (denoised rows are clamped at the image border exactly like the
+     * stand-alone detail pass clamps them) but reads and writes the bitmap only once.
+     */
+    private fun applyLunaDream20FinishingPass(
+        bitmap: Bitmap,
+        workers: ExecutorService,
+        workerCount: Int,
+        onProgress: ((Int) -> Unit)? = null
+    ) {
+        val width = bitmap.width
+        val height = bitmap.height
+        if (width < 3 || height < 3) return
+        val stripeCount = (height + LUNA20_STRIPE_ROWS - 1) / LUNA20_STRIPE_ROWS
+        val stripes = arrayOf(Luna20FinishStripe(width), Luna20FinishStripe(width))
+        val scratch = Array(workerCount) { Luna20ChunkScratch(width) }
+
+        fun load(stripe: Int, target: Luna20FinishStripe) {
+            val top = stripe * LUNA20_STRIPE_ROWS
+            val rows = min(LUNA20_STRIPE_ROWS, height - top)
+            // Buffer row i holds image row (top - 2 + i), replicated beyond the image border.
+            val firstY = max(0, top - 2)
+            val lastY = min(height - 1, top + rows + 1)
+            val readRows = lastY - firstY + 1
+            val firstIndex = firstY - (top - 2)
+            val lastIndex = firstIndex + readRows - 1
+            bitmap.getPixels(target.src, firstIndex * width, width, 0, firstY, width, readRows)
+            for (index in 0 until firstIndex) {
+                target.src.copyInto(target.src, index * width, firstIndex * width, (firstIndex + 1) * width)
+            }
+            for (index in lastIndex + 1 until rows + 4) {
+                target.src.copyInto(target.src, index * width, lastIndex * width, (lastIndex + 1) * width)
+            }
+            target.top = top
+            target.rows = rows
+        }
+
+        load(0, stripes[0])
+        for (stripe in 0 until stripeCount) {
+            val active = stripes[stripe and 1]
+            val pending = launchRowJobs(workers, workerCount, active.rows, LUNA20_CHUNK_ROWS) { worker, fromRow, untilRow ->
+                finishChunkLuna20(active, scratch[worker], width, height, fromRow, untilRow)
+            }
+            // The next stripe is read BEFORE this stripe is written back, so its halo rows
+            // are still the original (pre-filter) pixels.
+            if (stripe + 1 < stripeCount) load(stripe + 1, stripes[(stripe + 1) and 1])
+            pending.forEach { it.get() }
+            bitmap.setPixels(active.out, 0, width, 0, active.top, width, active.rows)
+            runCatching {
+                onProgress?.invoke(((active.top + active.rows) * 100 / height).coerceIn(0, 100))
+            }
+        }
+    }
+
+    private fun finishChunkLuna20(
+        stripe: Luna20FinishStripe,
+        scratch: Luna20ChunkScratch,
+        width: Int,
+        height: Int,
+        fromRow: Int,
+        untilRow: Int
+    ) {
+        val rc = untilRow - fromRow
+        val src = stripe.src
+        val srcLuma = scratch.srcLuma
+        val den = scratch.den
+        val denLuma = scratch.denLuma
+
+        // Luma of the rc + 4 source rows this chunk needs (two above, two below).
+        for (s in 0 until rc + 4) {
+            val colorOffset = (fromRow + s) * width
+            val lumaOffset = s * width
+            for (x in 0 until width) srcLuma[lumaOffset + x] = luma(src[colorOffset + x])
+        }
+        // Denoised rows y0 - 1 .. y0 + rc (rc + 2 rows) for the detail pass halo.
+        for (j in 0 until rc + 2) {
+            val s = j + 1
+            denoiseRowLuna20(
+                src, (fromRow + s - 1) * width, (fromRow + s) * width, (fromRow + s + 1) * width,
+                srcLuma, (s - 1) * width, s * width, (s + 1) * width,
+                width, den, denLuma, j * width
+            )
+        }
+        // At the image border the detail pass sees the denoised edge row replicated.
+        if (stripe.top + fromRow == 0) {
+            den.copyInto(den, 0, width, 2 * width)
+            denLuma.copyInto(denLuma, 0, width, 2 * width)
+        }
+        if (stripe.top + untilRow == height) {
+            den.copyInto(den, (rc + 1) * width, rc * width, (rc + 1) * width)
+            denLuma.copyInto(denLuma, (rc + 1) * width, rc * width, (rc + 1) * width)
+        }
+        for (r in 0 until rc) {
+            val j = r + 1
+            detailRowLuna20(
+                den, denLuma, (j - 1) * width, j * width, (j + 1) * width,
+                width, stripe.out, (fromRow + r) * width
+            )
+        }
+    }
+
+    /** One row of the strength-2 3x3 edge-aware denoise (same arithmetic as before). */
+    private fun denoiseRowLuna20(
+        src: IntArray,
+        srcAbove: Int,
+        srcCenter: Int,
+        srcBelow: Int,
+        lumaArray: IntArray,
+        lumaAbove: Int,
+        lumaCenter: Int,
+        lumaBelow: Int,
+        width: Int,
+        dst: IntArray,
+        dstLuma: IntArray,
+        dstOffset: Int
+    ) {
+        val baseBlend = baseBlendForDenoise(2)
+        for (x in 0 until width) {
+            val center = src[srcCenter + x]
+            val centerR = (center ushr 16) and 0xFF
+            val centerG = (center ushr 8) and 0xFF
+            val centerB = center and 0xFF
+            val centerLuma = lumaArray[lumaCenter + x]
+            val rangeLimit = if (centerLuma < 72) 27 else 20
+            var sumR = 0
+            var sumG = 0
+            var sumB = 0
+            var weightSum = 0
+            for (dy in -1..1) {
+                val colorRow = when (dy) {
+                    -1 -> srcAbove
+                    0 -> srcCenter
+                    else -> srcBelow
+                }
+                val lumaRow = when (dy) {
+                    -1 -> lumaAbove
+                    0 -> lumaCenter
+                    else -> lumaBelow
+                }
+                for (dx in -1..1) {
+                    if (dx == 0 && dy == 0) continue
+                    val nx = (x + dx).coerceIn(0, width - 1)
+                    val neighbor = src[colorRow + nx]
+                    val nr = (neighbor ushr 16) and 0xFF
+                    val ng = (neighbor ushr 8) and 0xFF
+                    val nb = neighbor and 0xFF
+                    val luminanceDelta = kotlin.math.abs(lumaArray[lumaRow + nx] - centerLuma)
+                    val colorDelta = max(
+                        kotlin.math.abs(nr - centerR),
+                        max(kotlin.math.abs(ng - centerG), kotlin.math.abs(nb - centerB))
+                    )
+                    val spatialWeight = if (dx == 0 || dy == 0) 2 else 1
+                    val weight = when {
+                        luminanceDelta <= rangeLimit && colorDelta <= rangeLimit * 2 -> spatialWeight
+                        luminanceDelta <= rangeLimit * 2 && colorDelta <= rangeLimit * 3 -> 1
+                        else -> 0
+                    }
+                    if (weight > 0) {
+                        sumR += nr * weight
+                        sumG += ng * weight
+                        sumB += nb * weight
+                        weightSum += weight
+                    }
+                }
+            }
+            val result = if (weightSum == 0) {
+                center
+            } else {
+                val shadowBoost = (1.22f - centerLuma / 255f * 0.42f).coerceIn(0.80f, 1.22f)
+                val blend = (baseBlend * shadowBoost).coerceIn(0.12f, 0.38f)
+                val averageR = sumR.toFloat() / weightSum
+                val averageG = sumG.toFloat() / weightSum
+                val averageB = sumB.toFloat() / weightSum
+                packRgb(
+                    (centerR * (1f - blend) + averageR * blend).roundToInt().coerceIn(0, 255),
+                    (centerG * (1f - blend) + averageG * blend).roundToInt().coerceIn(0, 255),
+                    (centerB * (1f - blend) + averageB * blend).roundToInt().coerceIn(0, 255)
+                )
+            }
+            dst[dstOffset + x] = result
+            dstLuma[dstOffset + x] = luma(result)
+        }
+    }
+
+    /** One row of the 2.0 luminance detail pass (same arithmetic as before, no vararg min/max). */
+    private fun detailRowLuna20(
+        colors: IntArray,
+        lumaArray: IntArray,
+        aboveOffset: Int,
+        centerOffset: Int,
+        belowOffset: Int,
+        width: Int,
